# Copy to .env and fill in. The app loads it at startup.
# Real environment variables take precedence, so an `export` still wins.
# .env is gitignored -- keep it that way.

# Dead Internet Mode's Discord bot. Create the application at
# https://discord.com/developers, enable the Message Content and Voice
# intents, then paste the bot token here.
DISCORD_TOKEN=

# Only needed when the LLM provider is set to "openai".
OPENAI_API_KEY=
